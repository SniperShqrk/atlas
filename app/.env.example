# Copy this to .env (or set the same keys in eas.json's build profiles) and
# fill in what you have. Every one of these is optional — with all of them
# blank, ATLAS runs exactly as it always has in local dev/testing: the AI
# planner calls localhost:4000, "Pro" is a local toggle in Profile, and no
# crash reports go anywhere.

# Your deployed backend URL (see /backend/DEPLOY.md). Leave unset to keep
# using http://localhost:4000 for local development.
EXPO_PUBLIC_API_URL=

# RevenueCat public API keys (Project settings → API keys in the RevenueCat
# dashboard — use the "public" app-specific key, not a secret key). Leave
# both blank to keep using the local dev Pro toggle instead of real IAP.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Sentry DSN (Project Settings → Client Keys (DSN) in your Sentry project).
# Leave blank to disable crash reporting entirely.
EXPO_PUBLIC_SENTRY_DSN=

# Supabase project URL + anon key (see /supabase/SETUP.md) — powers accounts,
# friends, groups and leaderboards under Profile → Friends & Groups. Leave
# both blank to keep that section showing a sign-in screen that isn't
# connected to anything yet; nothing else in the app depends on this.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
